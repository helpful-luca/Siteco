# Copy to .env. Nothing here is required: without a key the app runs in search-only mode.

# Claude API key (https://console.anthropic.com). Only the backend container reads it.
ANTHROPIC_API_KEY=

# Only if Anthropic answers "This API key is not scoped to a workspace": the workspace id
# (Anthropic Console > Workspaces), sent as the anthropic-workspace-id header.
# ANTHROPIC_WORKSPACE_ID=

# Host port for the web app (default 3000).
# APP_PORT=3000

# Optional shared secret between the web app and the backend.
# INTERNAL_TOKEN=

# Log level: DEBUG, INFO, WARNING
# LOG_LEVEL=INFO

# OCR with Tesseract (German and English) for scanned pages without a text layer, about 1 to 3 s
# per page with its own progress. "off" leaves such pages unsearchable.
# OCR=on
# OCR_PAGE_TIMEOUT_S=60

# Library limits (defaults shown). Sizes in MB.
# MAX_UPLOAD_MB=1024
# MAX_PDF_PAGES=5000
# MAX_CHARS_PER_DOC=50000000
# MAX_STORAGE_MB=20480
# MIN_FREE_DISK_MB=512

# Ingestion tuning: pages per parser batch, seconds per batch, threads for embedding
# (default: half the CPU cores, so questions stay fast during a large upload).
# PARSE_BATCH_PAGES=50
# PARSE_TIMEOUT_S=60
# EMBEDDING_THREADS=4

# Answers. `fake` answers without Claude (E2E tests, demo without key).
# LLM_PROVIDER=anthropic
# DEFAULT_MODEL=claude-sonnet-5-5
# SONNET_THINKING=adaptive
# MAX_OUTPUT_TOKENS=4096

# Retrieval and conversation. FULL_CONTEXT_MAX_TOKENS=0 turns the
# full-context mode for small scopes off.
# TOP_K=8
# RETRIEVAL_CANDIDATES=20
# PER_DOCUMENT_CAP=5
# FULL_CONTEXT_MAX_TOKENS=50000
# HISTORY_MAX_TURNS=6

# Chat limits. No daily budget unless set; costs are shown either way.
# MAX_CONCURRENT_STREAMS=3
# MAX_QUESTION_CHARS=4000
# DAILY_BUDGET_USD=5

# Privacy. Default for automatic deletion until it is chosen in Settings > Data: chats and
# documents older than this many days are deleted (checked every hour). 0 or unset: off.
# RETENTION_DAYS=30
