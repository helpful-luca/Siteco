# Copy to .env. Nothing here is required: without a key the app runs in search-only mode.

# Claude API key (https://console.anthropic.com). Only the backend container reads it.
ANTHROPIC_API_KEY=

# Host port for the web app (default 3000).
# APP_PORT=3000

# Optional shared secret between the web app and the backend.
# INTERNAL_TOKEN=

# Log level: DEBUG, INFO, WARNING
# LOG_LEVEL=INFO
